{
    "name": "mindcraft",
    "version": "1.20.1",
    "description": "Mindcraft AI NPC workspace configured for Minecraft Java 1.20.1",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.17.1",
        "@cerebras/cerebras_cloud_sdk": "^1.46.0",
        "@google/genai": "^1.15.0",
        "@huggingface/inference": "^2.8.1",
        "@mistralai/mistralai": "^1.1.0",
        "canvas": "^3.1.0",
        "cheerio": "^1.0.0",
        "express": "^4.18.2",
        "google-translate-api-x": "^10.7.1",
        "groq-sdk": "^0.15.0",
        "minecraft-assets": "^1.17.0",
        "minecraft-data": "^3.114.0",
        "minecraft-protocol": "^1.66.0",
        "minecrafthawkeye": "^1.3.9",
        "mineflayer": "^4.37.1",
        "mineflayer-armor-manager": "^2.0.1",
        "mineflayer-auto-eat": "^3.3.6",
        "mineflayer-collectblock": "^1.6.0",
        "mineflayer-pathfinder": "^2.4.5",
        "mineflayer-pvp": "^1.3.2",
        "open": "^10.2.0",
        "openai": "^4.4.0",
        "prismarine-item": "^1.18.0",
        "prismarine-schematic": "^1.3.0",
        "replicate": "^0.29.4",
        "ses": "^1.9.1",
        "socket.io": "^4.7.2",
        "socket.io-client": "^4.7.2",
        "three": "^0.128.0",
        "vec3": "^0.1.10",
        "yargs": "^17.7.2"
    },
    "overrides": {
        "canvas": "^3.1.0"
    },
    "scripts": {
        "postinstall": "patch-package",
        "start": "node main.js",
        "dashboard": "node scripts/dashboard.mjs",
        "test": "node --test test/*.test.js && node tools/civilization-smoke-test.js",
        "lint": "eslint .",
        "check": "npm run lint && npm test && npm run audit:minecraft",
        "test:civilization": "node tools/civilization-smoke-test.js",
        "test:gameplay": "node --test test/gameplay_modules.test.js",
        "audit:minecraft": "node tools/minecraft-1.20.1-audit.js",
        "reinstall": "npm run clean:modules && npm install",
        "clean:modules": "node -e \"const fs=require('fs');const p=require('path');['node_modules','package-lock.json'].forEach(f=>{if(fs.existsSync(f)){if(fs.lstatSync(f).isDirectory()){fs.rmSync(f,{recursive:true,force:true});}else{fs.unlinkSync(f);}}});\""
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "eslint": "^9.13.0",
        "eslint-plugin-no-floating-promise": "^2.0.0",
        "globals": "^15.11.0",
        "patch-package": "^8.0.0"
    }
}
